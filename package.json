{
  "name": "smtpfast-email-to-ticket",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A production-minded inbound email-to-ticket pipeline built with TypeScript, Fastify, PostgreSQL, and SMTPfast.",
  "engines": {
    "node": "^22.0.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed-demo": "tsx src/db/seed-demo.ts",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:integration": "vitest run tests/store.integration.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/formbody": "^8.0.2",
    "@fastify/static": "^10.1.4",
    "dotenv": "^17.2.2",
    "fastify": "^5.12.7",
    "pg": "^8.16.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
