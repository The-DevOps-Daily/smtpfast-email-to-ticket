NODE_ENV=development
HOST=0.0.0.0
PORT=3000

DATABASE_URL=postgres://tickets:tickets@localhost:55432/tickets

SMTPFAST_BASE_URL=https://smtpfa.st/api/v1
SMTPFAST_API_KEY=sf_live_replace_me

# Polling is the simplest local quickstart and needs no public HTTPS endpoint.
INGEST_MODE=poll
APP_SECRET=replace-with-at-least-32-random-characters

# Only required when INGEST_MODE=webhook.
# SMTPFAST_WEBHOOK_SECRET=whsec_replace_me

# Use a dedicated inbound subdomain so existing mailbox MX records stay untouched.
INBOUND_ADDRESS=support@inbound.example.com

# The ticket UI contains customer mail and can send replies. Put it behind HTTPS.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password

WORKER_ENABLED=true
WORKER_POLL_MS=5000
WORKER_BATCH_SIZE=20
WORKER_MAX_ATTEMPTS=8
